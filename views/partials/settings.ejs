<div class="col-md-12 col-lg-12">
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">General Settings</h1>
  </div>

  <form action="/admin/updateSettings" method="POST">
    
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-white fw-bold">Site Information</div>
      <div class="card-body">
          <div class="mb-3">
            <label for="siteName" class="form-label">Site Name</label>
            <input type="text" class="form-control" id="siteName" name="siteTitle" value="<%= settingsData.siteTitle %>">
          </div>
          <div class="mb-3">
            <label for="siteTagline" class="form-label">Tagline</label>
            <input type="text" class="form-control" id="siteTagline" name="tagLine" value="<%= settingsData.tagLine %>">
          </div>
          <div class="mb-3">
            <label for="adminEmail" class="form-label">Admin Email Address</label>
            <input type="email" class="form-control" id="adminEmail" name="adminEmail" value="<%= settingsData.adminEmail %>">
          </div>
      </div>
    </div>

    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-white fw-bold">Localization & Language</div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="timezone" class="form-label">Timezone</label>
            <select class="form-select" id="timezone" name="timezone">
              <option value="America/Los_Angeles" <%= settingsData.timezone === 'America/Los_Angeles' ? 'selected' : '' %>>(GMT+05:30) New Delhi, Mumbai, Kolkata</option>
              <option value="Europe/London" <%= settingsData.timezone === 'Europe/London' ? 'selected' : '' %>>(GMT+00:00) London</option>
              <option value="America/New_York" <%= settingsData.timezone === 'America/New_York' ? 'selected' : '' %>>(GMT-05:00) Eastern Time (US & Canada)</option>
            </select>
          </div>
          <div class="col-md-6 mb-3">
            <label for="language" class="form-label">Default Language</label>
            <select class="form-select" id="language" name="language">
              <option value="en" <%= settingsData.language === 'en' ? 'selected' : '' %>>English (US)</option>
              <option value="es" <%= settingsData.language === 'es' ? 'selected' : '' %>>Spanish</option>
              <option value="fr" <%= settingsData.language === 'fr' ? 'selected' : '' %>>French</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-white fw-bold">SEO & Search Visibility</div>
      <div class="card-body">
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" role="switch" id="searchEngineIndex" name="searchEngineIndex" value="true" <%= settingsData.searchEngineIndexing ? 'checked' : '' %>>
          <label class="form-check-label" for="searchEngineIndex">Allow search engines to index this site</label>
        </div>
        <div class="mb-3">
          <label for="metaDescription" class="form-label">Default Meta Description</label>
          <textarea class="form-control" id="metaDescription" name="description"
            rows="3"><%= settingsData.description %></textarea>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
      <button type="reset" class="btn btn-outline-secondary">Reset</button>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
  </form>
</div>
