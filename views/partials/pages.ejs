<div class="row g-3">
  <% navigationData.menuItems.forEach(function(item) { %>
    <div class="col-4">
      <div class="card p-4 position-relative overflow-hidden" style="border: 1px solid #635bff;">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h3 class="fw-bold text-dark mb-1"><%= item.label %></h3>
            <p class="mb-0 text-muted small fw-medium">More</p>
          </div>
          <a href="#">
            <span class="badge bg-opacity-10 text-success font-monospace">
              <i class="bi bi-pencil-square"></i>
            </span>
          </a>
        </div>
      </div>
    </div>
  <% }); %>
</div>