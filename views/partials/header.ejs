<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> CMS - <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
</head>

<body>
  <div class="sidebar" id="sidebarMenu">
    <div class="sidebar-brand">
      <div class="bg-primary text-white rounded p-1 d-flex align-items-center justify-content-center"
        style="width: 32px; height: 32px; background-color: var(--primary-purple) !important;">
        <i class="bi bi-columns-gap"></i>
      </div>
      <span class="fs-5 fw-bold text-dark-mode-target">CMS</span>
    </div>
  
    <ul class="nav flex-column mt-3">
      <li class="nav-item">
        <a class="nav-link <% if (pageName === 'Dashboard') { %>active<% } else { %><% } %>" href="/admin/dashboard">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <% if (pageName === 'Pages') { %>active<% } else { %><% } %>" href="/admin/pages"><i class="bi bi-layout-text-window-reverse"></i> Pages</a>
      </li>
      <li class="nav-item">
        <a class="nav-link <% if (pageName === 'Profile') { %>active<% } else { %><% } %>"
          href="/admin/profile">
          <i class="bi bi-person"></i> Profile</a>
      </li>
      <li class="nav-item">
        <a class="nav-link <% if (pageName === 'Settings') { %>active<% } else { %><% } %>" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
      </li>
    </ul>
  </div>
  
  <header class="main-header d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
      <button class="btn btn-link d-md-none p-0 text-dark fs-4" id="sidebarToggle">
        <i class="bi bi-list"></i>
      </button>
    </div>
  
    <div class="d-flex align-items-center gap-3">
      <!-- <div class="theme-toggle-btn text-muted" id="themeToggler" title="Toggle Light/Dark View">
        <i class="bi bi-moon-stars-fill fs-5" id="themeIcon"></i>
      </div> -->

      <div class="link-toggle-btn text-muted" id="linkToggler" title="Web View">
        <a href="<%= protocol %>://<%= host %>" target="_blank" class="text-decoration-none" style="color: grey;">
          <i class="bi bi-globe2"></i>
        </a>
      </div>
  
      <div class="vr mx-1"></div>
      
      <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userMenuDropdown"
          data-bs-toggle="dropdown" aria-expanded="false" style="color: grey;">
          <svg xmlns="http://w3.org" width="32" height="32" fill="grey" class="bi bi-person-circle"
            viewBox="0 0 16 16">
            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
            <path fill-rule="evenodd"
              d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z" />
          </svg>
        </a>
      
        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuDropdown">
          <li>
            <div class="dropdown-header">
              <strong>John Doe</strong><br>
              <small class="text-muted">john.doe@example.com</small>
            </div>
          </li>
          <li>
            <hr class="dropdown-divider">
          </li>
          <li><a class="dropdown-item text-danger" href="/logout">Logout</a></li>
        </ul>
      </div>

    </div>
  </header>

  <div class="content-wrapper">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none text-primary-purple">Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page"><%= pageName %></li>
      </ol>
    </nav>